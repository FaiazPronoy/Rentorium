# Copy to .env and fill in. .env is never committed.
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# With DEBUG off the site refuses to start on the placeholder key above, and
# sends plain HTTP to HTTPS. Set this to False if your host already does that.
DJANGO_SSL_REDIRECT=True

# Leave the email block empty to print mail to the console instead of sending it.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
SUPPORT_EMAIL=
